# Node modules
/node_modules/

# Build outputs (Vercel handles build server-side)
/dist/
/build/
/out/

# Local environment files (Vercel uses its own env vars)
.env
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# TypeScript incremental compilation
*.tsbuildinfo

# Testing coverage
/coverage/

# Storybook static build
/storybook-static/

# Misc
*.log

# Optional lock files (commit if you want reproducible installs)
# /package-lock.json
# /yarn.lock
# /pnpm-lock.yaml